{
  "info": {
    "_postman_id": "a1b2c3d4-movie-api-collection",
    "name": "Movie API",
    "description": "REST API for the movie-api project (Express + JWT). Default credentials: admin / 1234. Run **Login** first; the response test saves `token` to collection variables for movie requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "movieId",
      "value": "1",
      "description": "Set automatically after Create Movie, or paste a movie _id from GET /movies."
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/register",
            "description": "Registers a new user and returns 201 Created on success."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('token', data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"1234\"\n}"
            },
            "url": "{{baseUrl}}/login",
            "description": "Returns `{ \"token\": \"...\" }` on success (401 if invalid credentials). JWT expires in 1h. Token is stored in collection variable `token`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Movies",
      "item": [
        {
          "name": "Create movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const movie = pm.response.json();",
                  "    if (movie && movie._id) {",
                  "        pm.collectionVariables.set('movieId', movie._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\",\n  \"director\": \"Christopher Nolan\",\n  \"year\": 2010,\n  \"genre\": \"Sci-Fi\"\n}"
            },
            "url": "{{baseUrl}}/movies",
            "description": "Requires `title`, `year`, `genre`. `year` must be a number >= 1888. `director` is optional in validation but stored if sent. 201 on success. Saves returned `_id` to `movieId`."
          },
          "response": []
        },
        {
          "name": "Get all movies",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/movies",
            "description": "Returns an array of movies. 403 without Authorization header; 401 for invalid token."
          },
          "response": []
        },
        {
          "name": "Get movie by id",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/movies/{{movieId}}",
            "description": "200 if found; 404 `{ \"message\": \"Movie not found\" }` if id does not exist."
          },
          "response": []
        },
        {
          "name": "Update movie",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception (Director's Cut)\",\n  \"genre\": \"Sci-Fi / Thriller\"\n}"
            },
            "url": "{{baseUrl}}/movies/{{movieId}}",
            "description": "Partial update. If `year` is sent, it must be a number >= 1888. 404 if movie not found."
          },
          "response": []
        },
        {
          "name": "Delete movie",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/movies/{{movieId}}",
            "description": "200 `{ \"message\": \"Movie deleted successfully\" }` on success; 404 if not found."
          },
          "response": []
        }
      ]
    }
  ]
}
